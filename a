        btn.BackgroundColor3 = Theme.Secondary
        btn.BackgroundTransparency = 0.6
        btn.Text = "   " .. opt
        btn.TextColor3 = Theme.TextMuted
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 12
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.AutoButtonColor = false
        btn.Parent = optionsHolder
        corner(btn, 6)
        stroke(btn, Theme.Outline, 1, 0.8)
        
        btn.MouseEnter:Connect(function() tween(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.3, TextColor3 = Theme.Text}) end)
        btn.MouseLeave:Connect(function() tween(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.6, TextColor3 = Theme.TextMuted}) end)
        
        btn.MouseButton1Click:Connect(function()
            selectedLbl.Text = opt
            isOpen = false
            tween(dropdownFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quart), {Size = UDim2.new(1, -10, 0, 48)})
            tween(arrow, TweenInfo.new(0.4, Enum.EasingStyle.Quart), {Rotation = 0})
            task.delay(0.4, function() optionsHolder.Visible = false end)
            if callback then callback(opt) end
        end)
    end
    
    return dropdownFrame
end

local function createButton(parent, text, color, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.5, -5, 0, 36)
    btn.BackgroundColor3 = color or Theme.Card
    btn.Text = text
    btn.TextColor3 = Theme.Text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.AutoButtonColor = false
    btn.Parent = parent
    
    corner(btn, 8)
    local s = stroke(btn, Theme.Outline, 1, 0.6)
    
    btn.MouseEnter:Connect(function() 
        tween(btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Secondary})
        tween(s, TweenInfo.new(0.2), {Color = Theme.Accent})
    end)
    btn.MouseLeave:Connect(function() 
        tween(btn, TweenInfo.new(0.2), {BackgroundColor3 = color or Theme.Card})
        tween(s, TweenInfo.new(0.2), {Color = Theme.Outline})
    end)
    btn.MouseButton1Click:Connect(callback)
    
    return btn
end

local function createTextBox(parent, placeholder, callback)
    local boxFrame = Instance.new("Frame")
    boxFrame.Size = UDim2.new(1, -10, 0, 36)
    boxFrame.BackgroundColor3 = Theme.Card
    boxFrame.BorderSizePixel = 0
    boxFrame.Parent = parent
    corner(boxFrame, 8)
    stroke(boxFrame, Theme.Outline, 1, 0.6)
    
    local icon = label(boxFrame, "🔍", UDim2.new(0, 30, 1, 0), nil, 12, Theme.TextMuted, false)
    icon.TextXAlignment = Enum.TextXAlignment.Center
    
    local input = Instance.new("TextBox")
    input.Size = UDim2.new(1, -40, 1, 0)
    input.Position = UDim2.new(0, 35, 0, 0)
    input.BackgroundTransparency = 1
    input.Text = ""
    input.PlaceholderText = placeholder or "Search..."
    input.TextColor3 = Theme.Text
    input.PlaceholderColor3 = Theme.TextMuted
    input.Font = Enum.Font.Gotham
    input.TextSize = 13
    input.TextXAlignment = Enum.TextXAlignment.Left
    input.Parent = boxFrame
    
    input.FocusLost:Connect(function()
        if callback then callback(input.Text) end
    end)
    
    return boxFrame, input
end

