--// UI Utilities
local function cleanName(str)
    return str:gsub("%[.-%]", ""):gsub("<.-%>", ""):gsub("^%s*(.-)%s*$", "%1")
end

local function findMob(targetName)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
            local hum = v.Humanoid
            local name = v.Name
            
            if hum.DisplayName ~= "" and hum.DisplayName ~= "Humanoid" then
                name = cleanName(hum.DisplayName)
            else
                for _, desc in ipairs(v:GetDescendants()) do
                    if desc:IsA("BillboardGui") then
                        local tl = desc:FindFirstChildWhichIsA("TextLabel")
                        if tl and tl.Text ~= "" and not tl.Text:find("/") then
                            name = cleanName(tl.Text)
                            break
                        end
                    end
                end
            end
            
            if name == targetName then
                return v.HumanoidRootPart
            end
        end
    end
    return nil
end

local function clearContent()
    for _, child in ipairs(contentHolder:GetChildren()) do
        if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
            child:Destroy()
        end
    end
end

local function getGameMobs()
    local mobs = {}
    local seen = {}
    
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(v) then
            local hum = v:FindFirstChild("Humanoid")
            local possibleNames = {}
            
            if hum and hum.DisplayName ~= "" and hum.DisplayName ~= "Humanoid" then
                possibleNames[#possibleNames + 1] = cleanName(hum.DisplayName)
            end
            
            for _, desc in ipairs(v:GetDescendants()) do
                if desc:IsA("BillboardGui") then
                    local tl = desc:FindFirstChildWhichIsA("TextLabel")
                    if tl and tl.Text ~= "" and not tl.Text:find("/") and not tl.Text:find("%%") then
                        possibleNames[#possibleNames + 1] = cleanName(tl.Text)
                    end
                elseif desc:IsA("StringValue") and (desc.Name:find("Name") or desc.Name:find("Display")) then
                    possibleNames[#possibleNames + 1] = cleanName(desc.Value)
                end
            end
            
            possibleNames[#possibleNames + 1] = v.Name
            
            local bestName = nil
            for _, n in ipairs(possibleNames) do
                if n ~= "" and n:len() > 1 then
                    if not (n:len() > 20 and n:find("-")) and not n:find("^0x") then
                        bestName = n
                        break
                    end
                end
            end
            
            if not bestName and #possibleNames > 0 then
                bestName = possibleNames[1]
            end
            
            if bestName and bestName ~= "" and not seen[bestName] then
                mobs[#mobs + 1] = bestName
                seen[bestName] = true
            end
        end
    end
    table.sort(mobs)
    return mobs
end

