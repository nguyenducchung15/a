--// Dragging Logic
local dragToggle = nil
local dragSpeed = 0.15
local dragStart = nil
local startPos = nil

local function updateInput(input)
    local delta = input.Position - dragStart
    local position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    tween(main, TweenInfo.new(dragSpeed), {Position = position})
end

topBar.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        dragToggle = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragToggle = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        if dragToggle then
            updateInput(input)
        end
    end
end)

--// Background Tasks
local currentTarget = nil
local lastHakiPress = 0

-- Task to maintain target cache
task.spawn(function()
    while screenGui.Parent do
        if Settings.AutoFarm and selectedMob ~= "None" then
            if not currentTarget or not currentTarget.Parent or not currentTarget:FindFirstChild("Humanoid") or currentTarget.Humanoid.Health <= 0 then
                local hrp = findMob(selectedMob)
                currentTarget = hrp and hrp.Parent
            end
        else
            currentTarget = nil
        end
        task.wait(0.5)
    end
end)

-- Auto Equip Task
task.spawn(function()
    while screenGui.Parent do
        if Settings.AutoEquip and Settings.SelectedTool ~= "None" and Settings.SelectedTool ~= "No Tools Found" then
            local char = player.Character
            if char and not char:FindFirstChild(Settings.SelectedTool) then
                local tool = player.Backpack:FindFirstChild(Settings.SelectedTool)
                if tool then
                    char.Humanoid:EquipTool(tool)
                end
            end
        end
        task.wait(0.5)
    end
end)

-- Auto Skill Task
task.spawn(function()
    local keys = {"Z", "X", "C", "V", "B", "F"}
    while screenGui.Parent do
        if Settings.AutoSkill then
            for _, key in ipairs(keys) do
                if Settings.Skills[key] then
                    VIM:SendKeyEvent(true, Enum.KeyCode[key], false, game)
                    task.wait(0.05)
                    VIM:SendKeyEvent(false, Enum.KeyCode[key], false, game)
                    task.wait(0.1)
                end
            end
        end
        task.wait(0.5)
    end
end)

-- Auto Teleport Farm Task
task.spawn(function()
    while screenGui.Parent do
        if Settings.AutoFarm then
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            
            if hrp and hum and currentTarget and currentTarget:FindFirstChild("HumanoidRootPart") then
                local targetHrp = currentTarget.HumanoidRootPart
                local targetPos = targetHrp.Position + Vector3.new(0, 7, 0)
                
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                hum.PlatformStand = true
                
                char:PivotTo(CFrame.lookAt(targetPos, targetHrp.Position))
            elseif hum then
                hum.PlatformStand = false
            end
        end
        task.wait(0.02)
    end
end)

-- Auto Haki Task
task.spawn(function()
    while screenGui.Parent do
        if Settings.AutoHaki and tick() - lastHakiPress > 3 then
            if not isHakiEnabled() then
                lastHakiPress = tick()
                VIM:SendKeyEvent(true, Enum.KeyCode.J, false, game)
                task.wait(0.1)
                VIM:SendKeyEvent(false, Enum.KeyCode.J, false, game)
            end
        end
        task.wait(1)
    end
end)

