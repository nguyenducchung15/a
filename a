--// Helper Functions
local function getInventoryTools()
    local tools = {}
    if player.Backpack then
        for _, v in ipairs(player.Backpack:GetChildren()) do
            if v:IsA("Tool") then tools[#tools + 1] = v.Name end
        end
    end
    if player.Character then
        for _, v in ipairs(player.Character:GetChildren()) do
            if v:IsA("Tool") then tools[#tools + 1] = v.Name end
        end
    end
    return tools
end

local function isHakiEnabled()
    local char = player.Character
    if not char then return false end
    
    -- 1. Check for specific V1/Status values (Aggressive search)
    for _, v in ipairs(char:GetDescendants()) do
        -- Check V1 logic
        if v.Name:lower() == "v1" and typeof(v.Value) == "boolean" then
            if not v.Value then return true end
        end
        -- Check A/D status in StringValues
        if v:IsA("StringValue") and v.Value == "A" then
            return true
        end
    end
    
    -- 2. Check for SelectionBox (Common Aura/Haki effect)
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("SelectionBox") then
            return true
        end
    end
    
    -- 3. Check for specific Child Objects
    if char:FindFirstChild("HasHaki") or char:FindFirstChild("Aura") or char:FindFirstChild("Haki") then
        return true
    end
    
    -- 4. Check for Particle Effects (Haki smoke/glow) - CONFIRMED WORKING
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("ParticleEmitter") and v.Enabled then
            if v.Name:lower():find("haki") or v.Name:lower():find("aura") or v.Name:lower():find("effect") then
                return true
            end
        end
    end
    
    -- 5. Visual check (Only if arm is DARK)
    local arm = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftHand")
    if arm and arm:IsA("BasePart") and arm.Color.R < 0.2 then
        return true
    end
    
    return false
end

--// Utility Functions
local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 12)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Theme.Outline
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function gradient(parent, colors, rotation)
    local g = Instance.new("UIGradient")
    g.Color = colors or ColorSequence.new(Theme.Accent, Theme.AccentLight)
    g.Rotation = rotation or 0
    g.Parent = parent
    return g
end

local function tween(obj, info, goal)
    local t = TS:Create(obj, info, goal)
    t:Play()
    return t
end

local function label(parent, text, size, pos, textSize, color, bold)
    local t = Instance.new("TextLabel")
    t.Text = text
    t.Size = size or UDim2.new(1, 0, 1, 0)
    t.Position = pos or UDim2.new(0, 0, 0, 0)
    t.BackgroundTransparency = 1
    t.TextColor3 = color or Theme.Text
    t.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
    t.TextSize = textSize or 14
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.TextYAlignment = Enum.TextYAlignment.Center
    t.RichText = true
    t.TextWrapped = true
    t.ZIndex = (parent.ZIndex or 1) + 1
    t.Parent = parent
    return t
end

